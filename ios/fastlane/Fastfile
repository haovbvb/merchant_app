default_platform(:ios)

require "json"
require "time"

platform :ios do
  def detect_profile_name(app_identifier:, export_method: "ad-hoc")
    profile_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    return nil unless Dir.exist?(profile_dir)

    candidates = []
    Dir.glob(File.join(profile_dir, "*.mobileprovision")).each do |path|
      begin
        tmp_plist = File.expand_path("./tmp_profile_#{Process.pid}.plist", __dir__)
        File.write(tmp_plist, sh("security", "cms", "-D", "-i", path, log: false))
        json = sh("plutil", "-convert", "json", "-o", "-", tmp_plist, log: false)
        data = JSON.parse(json)
        FileUtils.rm_f(tmp_plist)

        entitlements = data["Entitlements"] || {}
        app_id = entitlements["application-identifier"].to_s
        next unless app_id.end_with?(app_identifier)

        expiration = data["ExpirationDate"]
        next if expiration && Time.parse(expiration.to_s) <= Time.now

        all_devices = data["ProvisionsAllDevices"] == true
        provisioned_devices = data["ProvisionedDevices"] || []
        device_count = all_devices ? 999_999 : provisioned_devices.size

        profile_name = data["Name"].to_s
        next if profile_name.empty?

        # ad-hoc 需要有设备列表且非企业包；development 允许开发证书 profile
        if export_method == "ad-hoc"
          next if all_devices
          next if provisioned_devices.empty?
        end

        candidates << {
          name: profile_name,
          devices: device_count,
          expiration: expiration.to_s,
        }
      rescue
        FileUtils.rm_f(File.expand_path("./tmp_profile_#{Process.pid}.plist", __dir__))
        next
      end
    end

    return nil if candidates.empty?

    picked = candidates.max_by { |item| [item[:devices], item[:expiration]] }
    UI.message("🔎 Auto selected profile '#{picked[:name]}' (devices=#{picked[:devices]}, exp=#{picked[:expiration]})")
    picked[:name]
  end

  def upload_to_pgyer(file_path:, api_key:, update_desc: "", install_type: "1", password: "", app_key: "")
    upload_cmd = [
      "curl", "-f", "-X", "POST", "https://www.pgyer.com/apiv2/app/upload",
      "-F", "_api_key=#{api_key}",
      "-F", "file=@#{file_path}",
      "-F", "buildUpdateDescription=#{update_desc}",
      "-F", "buildInstallType=#{install_type}",
    ]

    upload_cmd += ["-F", "buildPassword=#{password}"] unless password.to_s.empty?
    upload_cmd += ["-F", "buildKey=#{app_key}"] unless app_key.to_s.empty?

    sh(*upload_cmd)
  end

  def clean_build_cache
    UI.message("🧹 Cleaning build caches to free disk space...")
    project_root = File.expand_path("../..", __dir__)
    # Flutter build outputs
    FileUtils.rm_rf(File.join(project_root, "build"))
    # iOS DerivedData & build
    FileUtils.rm_rf(File.join(project_root, "ios", "build"))
    # Xcode DerivedData (global)
    derived_data = File.expand_path("~/Library/Developer/Xcode/DerivedData")
    FileUtils.rm_rf(Dir.glob(File.join(derived_data, "*"))) if Dir.exist?(derived_data)
    # Xcode Archives
    archives = File.expand_path("~/Library/Developer/Xcode/Archives")
    FileUtils.rm_rf(Dir.glob(File.join(archives, "*"))) if Dir.exist?(archives)
    UI.success("✅ Build caches cleaned.")
  end

  def generate_export_options_plist(app_identifier:, team_id:)
    export_method = (ENV["IOS_EXPORT_METHOD"] || "ad-hoc").strip
    signing_style = (ENV["IOS_SIGNING_STYLE"] || "automatic").strip
    profile_name = (ENV["IOS_PROFILE_NAME"] || "").strip

    if !profile_name.empty? && signing_style != "manual"
      signing_style = "manual"
    end

    if signing_style == "manual" && profile_name.empty?
      profile_name = detect_profile_name(
        app_identifier: app_identifier,
        export_method: export_method,
      ).to_s.strip
    end

    if signing_style == "manual" && profile_name.empty?
      UI.user_error!("IOS_PROFILE_NAME is required when IOS_SIGNING_STYLE=manual. You can set IOS_PROFILE_NAME explicitly, or install an AdHoc profile for #{app_identifier} first.")
    end

    if signing_style == "automatic" && export_method == "ad-hoc"
      UI.important("⚠️ Using automatic signing with ad-hoc export may pick a profile with limited devices.")
    end

    export_plist_path = File.expand_path("./ExportOptions.generated.plist", __dir__)
    provisioning_profiles_xml = if signing_style == "manual"
                                  <<~XML
                                    <key>provisioningProfiles</key>
                                    <dict>
                                      <key>#{app_identifier}</key>
                                      <string>#{profile_name}</string>
                                    </dict>
                                  XML
                                else
                                  ""
                                end

    File.write(
      export_plist_path,
      <<~XML
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>method</key>
          <string>#{export_method}</string>
          <key>signingStyle</key>
          <string>#{signing_style}</string>
          <key>teamID</key>
          <string>#{team_id}</string>
          #{provisioning_profiles_xml}
          <key>compileBitcode</key>
          <false/>
          <key>stripSwiftSymbols</key>
          <true/>
        </dict>
        </plist>
      XML
    )

    UI.message("📦 iOS export_method=#{export_method}, signing_style=#{signing_style}, profile=#{profile_name.empty? ? 'AUTO' : profile_name}")
    export_plist_path
  end

  desc "Build Flutter iOS IPA and upload to Pgyer"
  lane :pgyer do
    app_identifier = "com.okla.ops"
    team_id = "39634H5Y8U"
    pgyer_api_key = "630a6a4d973bda999b5ca54affaebc60"
    pgyer_app_key = ENV["PGYER_APP_KEY"]
    update_desc = ENV["PGYER_UPDATE_DESCRIPTION"] || ""
    install_type = ENV["PGYER_INSTALL_TYPE"] || "1"
    password = ENV["PGYER_PASSWORD"] || ""
    ipa_path = ENV["IPA_PATH"]
    project_root = File.expand_path("../..", __dir__)

    UI.user_error!("APP_IDENTIFIER is required") if app_identifier.to_s.strip.empty?
    UI.user_error!("TEAM_ID is required") if team_id.to_s.strip.empty?
    UI.user_error!("PGYER_API_KEY is required") if pgyer_api_key.to_s.strip.empty?

    clean_build_cache

    now = Time.now
    ios_build_number = now.strftime("%Y%m%d%H%M")
    export_plist_path = generate_export_options_plist(
      app_identifier: app_identifier,
      team_id: team_id,
    )
    sh "flutter", "build", "ipa", "--release", "--build-number=#{ios_build_number}", "--export-options-plist=#{export_plist_path}"

    if ipa_path.to_s.strip.empty?
      ipa_candidates = Dir[File.join(project_root, "build/ios/ipa/*.ipa")]
      UI.user_error!("IPA not found in #{File.join(project_root, 'build/ios/ipa')}") if ipa_candidates.empty?
      ipa_path = ipa_candidates.first
    end
    upload_to_pgyer(
      file_path: ipa_path,
      api_key: pgyer_api_key,
      update_desc: update_desc,
      install_type: install_type,
      password: password,
      app_key: pgyer_app_key,
    )
  end

  desc "Build Flutter iOS + Android and upload both to Pgyer"
  lane :pgyer_all do
    app_identifier = "com.okla.ops"
    team_id = "39634H5Y8U"
    pgyer_api_key = "630a6a4d973bda999b5ca54affaebc60"
    pgyer_app_key = ENV["PGYER_APP_KEY"]
    update_desc = ENV["PGYER_UPDATE_DESCRIPTION"] || ""
    install_type = ENV["PGYER_INSTALL_TYPE"] || "1"
    password = ENV["PGYER_PASSWORD"] || ""
    ipa_path = ENV["IPA_PATH"]
    android_artifact = ENV["ANDROID_ARTIFACT"] || "apk" # apk or aab
    android_artifact_path = ENV["ANDROID_ARTIFACT_PATH"]
    project_root = File.expand_path("../..", __dir__)

    UI.user_error!("APP_IDENTIFIER is required") if app_identifier.to_s.strip.empty?
    UI.user_error!("TEAM_ID is required") if team_id.to_s.strip.empty?
    UI.user_error!("PGYER_API_KEY is required") if pgyer_api_key.to_s.strip.empty?

    clean_build_cache

    now = Time.now
    ios_build_number = now.strftime("%Y%m%d%H%M")  # e.g. 202602090928
    # Android versionCode max 2100000000, use (year-2020) prefix to stay under limit
    android_build_number = "#{now.year - 2020}#{now.strftime('%m%d%H%M')}"  # e.g. 602090928
    export_plist_path = generate_export_options_plist(
      app_identifier: app_identifier,
      team_id: team_id,
    )
    sh "flutter", "build", "ipa", "--release", "--build-number=#{ios_build_number}", "--export-options-plist=#{export_plist_path}"
    sh "flutter", "build", android_artifact, "--release", "--build-number=#{android_build_number}"

    if ipa_path.to_s.strip.empty?
      ipa_candidates = Dir[File.join(project_root, "build/ios/ipa/*.ipa")]
      UI.user_error!("IPA not found in #{File.join(project_root, 'build/ios/ipa')}") if ipa_candidates.empty?
      ipa_path = ipa_candidates.first
    end

    if android_artifact_path.to_s.strip.empty?
      if android_artifact == "aab"
        candidates = Dir[File.join(project_root, "build/app/outputs/bundle/release/*.aab")]
        UI.user_error!("AAB not found in #{File.join(project_root, 'build/app/outputs/bundle/release')}") if candidates.empty?
        android_artifact_path = candidates.first
      else
        candidates = Dir[File.join(project_root, "build/app/outputs/flutter-apk/*.apk")]
        UI.user_error!("APK not found in #{File.join(project_root, 'build/app/outputs/flutter-apk')}") if candidates.empty?
        android_artifact_path = candidates.first
      end
    end

    upload_to_pgyer(
      file_path: ipa_path,
      api_key: pgyer_api_key,
      update_desc: update_desc,
      install_type: install_type,
      password: password,
      app_key: pgyer_app_key,
    )

    upload_to_pgyer(
      file_path: android_artifact_path,
      api_key: pgyer_api_key,
      update_desc: update_desc,
      install_type: install_type,
      password: password,
      app_key: pgyer_app_key,
    )
  end
end
