<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="Object" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/f8f8f8"
        android:orientation="vertical">

        <include
            android:id="@+id/includeTitle"
            layout="@layout/base_title_mvvm_layout" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/color_fff5f6f7"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginRight="@dimen/dp_10"
                    android:background="@drawable/bg_gradient_0278er_32a5fc_r8">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/img_bluetooth_operate_key"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent" />

                    <ImageView
                        android:id="@+id/img_bluetooth_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/icon_bluetooth_operate"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:textColor="#ffffff"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toRightOf="@id/img_bluetooth_icon"
                        app:layout_constraintTop_toTopOf="@id/img_bluetooth_icon"
                        tools:text="iphone xs max" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/bluetooth_connect_state"
                        android:textColor="#ffffff"
                        android:textSize="13sp"
                        app:layout_constraintLeft_toLeftOf="@id/tv_device_name"
                        app:layout_constraintTop_toBottomOf="@id/tv_device_name" />


                    <include
                        android:id="@+id/reset_authorization"
                        layout="@layout/left_right_arrow_include_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/img_bluetooth_icon" />

                    <include
                        android:id="@+id/factory_authorized_entrance"
                        layout="@layout/left_right_arrow_include_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/reset_authorization" />

                    <include
                        android:id="@+id/clear_authorization"
                        layout="@layout/left_right_arrow_include_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/factory_authorized_entrance" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_ffffff_r8"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tv_authorize"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:drawablePadding="5dp"
                        android:gravity="center_vertical"
                        android:text="@string/switch_cabinet_authorization"
                        android:textColor="@color/text_333"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_sn"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_f6f7f8_r5"
                        android:ellipsize="end"
                        android:hint="@string/cabinet_opt_bluetooth_input_tips"
                        android:imeOptions="actionSearch"
                        android:paddingStart="10dp"
                        android:paddingEnd="60dp"
                        android:singleLine="true"
                        android:textColor="@color/text_333"
                        android:textColorHint="@color/bfbfc8"
                        android:textSize="14sp"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_authorize" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_scan"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        app:layout_constraintBottom_toBottomOf="@id/et_sn"
                        app:layout_constraintRight_toRightOf="@id/et_sn"
                        app:layout_constraintTop_toTopOf="@id/et_sn">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:scaleType="center"
                            android:src="@mipmap/icon_black_scan"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/tv_add_authorize"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_maincolor_r8"
                        android:gravity="center"
                        android:text="@string/cabinet_opt_open_authorization"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/et_sn" />

                    <TextView
                        android:id="@+id/tv_clear_authorize"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_line_d9d9d9_r8"
                        android:gravity="center"
                        android:text="@string/clear_authorization"
                        android:textColor="@color/color_b30c0c0d"
                        android:textSize="14sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_add_authorize" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp">

                    <TextView
                        android:id="@+id/tvTipTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:drawablePadding="5dp"
                        android:gravity="center"
                        android:text="@string/str_tips"
                        android:textColor="@color/text_333"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/color_e6e6e6"
                        app:layout_constraintBottom_toBottomOf="@id/tvTipTitle"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@id/tvTipTitle"
                        app:layout_constraintTop_toTopOf="@id/tvTipTitle" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/color_e6e6e6"
                        app:layout_constraintBottom_toBottomOf="@id/tvTipTitle"
                        app:layout_constraintLeft_toRightOf="@id/tvTipTitle"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvTipTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bluetooth_operate_tip"
                        android:textColor="@color/color_b30c0c0d"
                        android:textSize="12sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTipTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>