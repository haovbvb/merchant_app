<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/includeTitle"
            layout="@layout/base_title_mvvm_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clUserInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintTop_toBottomOf="@id/includeTitle">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitStart"
                android:src="@mipmap/bg_mine"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imDevice"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_line_f2f2f2_r4"
                android:padding="2dp"
                android:scaleType="fitXY"
                app:civ_border_color="@color/white"
                app:civ_border_width="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0" />

            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:textColor="@color/color_e60c0c0d"
                android:textSize="19sp"
                app:layout_constraintLeft_toRightOf="@id/imDevice"
                app:layout_constraintRight_toLeftOf="@id/ivCabinet"
                app:layout_constraintTop_toTopOf="@id/imDevice"
                tools:text="Shenzhen Qianwan Park and Sanram Esquare 12-Slot Station" />

            <ImageView
                android:id="@+id/ivCabinet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:background="@drawable/shape_circle_line_330c0c0d"
                android:src="@drawable/icon_cabinet"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/imDevice"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/imDevice" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="17dp"
                android:drawablePadding="2dp"
                android:paddingStart="4dp"
                android:paddingTop="3dp"
                android:paddingEnd="4dp"
                android:paddingBottom="3dp"
                android:textColor="@color/color_800c0c0d"
                android:textSize="13sp"
                app:layout_constraintBottom_toTopOf="@id/magic_indicator"
                app:layout_constraintLeft_toRightOf="@id/imDevice"
                app:layout_constraintTop_toBottomOf="@id/tvDeviceInfo"
                app:layout_constraintVertical_bias="0"
              />

            <TextView
                android:id="@+id/tvBluetoothStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="4dp"
                android:paddingTop="3dp"
                android:paddingEnd="4dp"
                android:paddingBottom="3dp"
                android:textColor="@color/color_6c7180"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/tvStatus"
                app:layout_constraintLeft_toRightOf="@id/tvStatus"
                app:layout_constraintTop_toTopOf="@id/tvStatus"
                app:layout_constraintVertical_bias="0" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnRestart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_f2f5fa_r8"
                android:paddingVertical="10dp"
                app:layout_constraintBottom_toTopOf="@id/magic_indicator"
                app:layout_constraintEnd_toStartOf="@id/btnOpenTheDoor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imDevice">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvRestart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_restart"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:text="@string/cabinet_opt_cabinet_offline_restart"
                    android:textColor="@color/cc_color_e60c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnOpenTheDoor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_f2f5fa_r8"
                android:paddingVertical="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnRestart"
                app:layout_constraintTop_toTopOf="@id/btnRestart">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvOpenTheDoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_door"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:text="@string/cabinet_opt_cabinet_offline_open_door"
                    android:textColor="@color/cc_color_e60c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <net.lucode.hackware.magicindicator.MagicIndicator
                android:id="@+id/magic_indicator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnRestart"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clUserInfo"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
