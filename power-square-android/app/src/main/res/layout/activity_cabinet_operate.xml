        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fff5f6f7"
        android:orientation="vertical">

        <include
            android:id="@+id/includeTitle"
            layout="@layout/base_title_mvvm_layout" />

