<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f5f6f7">

        <include
            android:id="@+id/includeTitle"
            layout="@layout/base_title_mvvm_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/llBottom"
            app:layout_constraintTop_toBottomOf="@id/includeTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/bgTransportAddress"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_ffffff_r8"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iv_issue"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="fitXY"
                    android:src="@mipmap/icon_issue_warehouse"
                    app:layout_constraintStart_toStartOf="@+id/vLine"
                    app:layout_constraintTop_toBottomOf="@+id/vLine" />

                <View
                    android:id="@+id/vLine"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/color_e6e6e6"
                    app:layout_constraintEnd_toEndOf="@+id/bgTransportAddress"
                    app:layout_constraintStart_toStartOf="@+id/tvSendWarehouse"
                    app:layout_constraintTop_toBottomOf="@+id/tvSendWarehouse" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSendWarehouse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="9dp"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/transport_issue_warehouse"
                    android:textColor="@color/color_e6000000"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="@id/bgTransportAddress"
                    app:layout_constraintTop_toTopOf="@id/bgTransportAddress"
                    tools:text="发出仓库" />

                <TextView
                    android:id="@+id/tv_sendname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/transport_issue_platfomr_name"
                    android:textColor="#e60c0c0d"
                    android:textSize="15sp"
                    app:layout_constraintStart_toEndOf="@+id/iv_issue"
                    app:layout_constraintTop_toBottomOf="@+id/vLine" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSendAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="2"
                    android:text="@string/transport_issue_platfomr_address"
                    android:textColor="@color/color_66000000"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/bgTransportAddress"
                    app:layout_constraintStart_toEndOf="@+id/iv_issue"
                    app:layout_constraintTop_toBottomOf="@id/tv_sendname" />

                <View
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/bgTransportAddress"
                    android:id="@+id/viewbg_receiver"
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:background="@drawable/bg_ffffff_r8"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvReceiveWarehouse"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@mipmap/icon_receive_warehouse"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/transport_receiving_warehouse"
                    android:textColor="@color/color_b30c0c0d"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="@id/viewbg_receiver"
                    app:layout_constraintTop_toTopOf="@+id/viewbg_receiver"
                    tools:text="接收仓库" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvReceiveAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="12dp"
                    android:drawableEnd="@mipmap/arrow_next"
                    android:drawablePadding="10dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:hint="@string/transport_select_warehouse"
                    android:maxLines="2"
                    android:textColor="@color/color_e60c0c0d"
                    android:textColorHint="@color/color_4d0c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="@id/viewbg_receiver"
                    app:layout_constraintStart_toStartOf="@id/viewbg_receiver"
                    app:layout_constraintTop_toBottomOf="@id/tvReceiveWarehouse"
                    tools:text="Nantou Community Service Point, Nanshan District, Shenzhen" />

                <View
                    android:id="@+id/line2"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/cc_color_e6e6e6"
                    app:layout_constraintEnd_toEndOf="@+id/viewbg_receiver"
                    app:layout_constraintStart_toStartOf="@+id/tvReceiveAddress"
                    app:layout_constraintTop_toBottomOf="@+id/tvReceiveAddress" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPostNumberTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:drawableStart="@drawable/icon_post_number"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/transport_tracking_number"
                    android:textColor="@color/color_b30c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="@+id/tvReceiveWarehouse"
                    app:layout_constraintTop_toBottomOf="@+id/line2"
                    tools:text="物流快递单号" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPostNumber"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="12dp"
                    android:background="@android:color/transparent"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:hint="@string/transport_enter_tracking_number"
                    android:maxLength="50"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/color_e60c0c0d"
                    android:textColorHint="@color/color_4d0c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/viewbg_receiver"
                    app:layout_constraintEnd_toEndOf="@id/viewbg_receiver"
                    app:layout_constraintStart_toStartOf="@id/viewbg_receiver"
                    app:layout_constraintTop_toBottomOf="@id/tvPostNumberTitle"
                    tools:text="123131301231023120" />

                <View
                    android:id="@+id/bgSelectBattery"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/white"
                    app:layout_constraintBottom_toBottomOf="@+id/view1"
                    app:layout_constraintTop_toBottomOf="@id/viewbg_receiver" />

                <View
                    android:id="@+id/view1"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    app:layout_constraintStart_toStartOf="@+id/tvEnterDeviceSn"
                    app:layout_constraintTop_toBottomOf="@+id/tvEnterDeviceSn"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSelectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/color_e60c0c0d"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="@id/bgSelectBattery"
                    app:layout_constraintTop_toTopOf="@id/bgSelectBattery" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvEnterDeviceSn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_line_66000000_r8"
                    android:drawableStart="@mipmap/icon_enter_sn"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingEnd="0dp"
                    android:text="@string/transport_enter_device_sn"
                    android:textColor="@color/color_e60c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/tvScanQRCode"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="@id/bgSelectBattery"
                    app:layout_constraintTop_toBottomOf="@id/tvSelectTitle" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScanQRCode"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="4dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_line_maincolor_r8"
                    android:drawableStart="@mipmap/icon_blue_scan"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:text="@string/transport_scan_qr_code"
                    android:textColor="@color/main_color"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvEnterDeviceSn"
                    app:layout_constraintEnd_toEndOf="@id/bgSelectBattery"
                    app:layout_constraintStart_toEndOf="@id/tvEnterDeviceSn"
                    app:layout_constraintTop_toTopOf="@id/tvEnterDeviceSn" />

                <LinearLayout
                    android:id="@+id/llSn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/bgSelectBattery" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llBottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:background="@drawable/bg_shade_top"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvConfirm"
                android:layout_width="175dp"
                android:layout_height="44dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/selector_confirm"
                android:enabled="false"
                android:gravity="center"
                android:text="@string/transport_cabinet_confirm"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotal"
                app:layout_constraintBottom_toBottomOf="@+id/tvConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/transport_total_issued"
                android:textColor="@color/color_800c0c0d"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/color_e60c0c0d"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/tvTotal"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="4" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
