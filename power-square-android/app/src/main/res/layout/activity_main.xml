<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".views.MainActivity">

        <com.okla.ops.weight.NoScrollViewPager
            android:id="@+id/mViewpager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/home_indicator_workbench"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:alpha="0.6"
            android:background="@drawable/bg_shade_top"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/home_indicator_monitor"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="6dp"
            android:text="@string/tab_monitor"
            android:textColor="@color/selector_text_fa4332"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/home_indicator_workbench"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/iv_home_indicator_monitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/selector_monitor"
            app:layout_constraintEnd_toEndOf="@id/home_indicator_monitor"
            app:layout_constraintStart_toStartOf="@id/home_indicator_monitor"
            app:layout_constraintTop_toTopOf="@id/home_indicator_monitor" />

        <TextView
            android:id="@+id/home_indicator_workbench"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="6dp"
            android:text="@string/tab_workbench"
            android:textColor="@color/selector_text_fa4332"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/home_indicator_mine"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toEndOf="@id/home_indicator_monitor" />

        <ImageView
            android:id="@+id/iv_home_indicator_workbench"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/selector_workbench"
            app:layout_constraintEnd_toEndOf="@id/home_indicator_workbench"
            app:layout_constraintStart_toStartOf="@id/home_indicator_workbench"
            app:layout_constraintTop_toTopOf="@id/home_indicator_workbench" />

        <TextView
            android:id="@+id/home_indicator_mine"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="6dp"
            android:text="@string/tab_mine"
            android:textColor="@color/selector_text_fa4332"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/home_indicator_workbench" />

        <ImageView
            android:id="@+id/iv_home_indicator_mine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/selector_mine"
            app:layout_constraintEnd_toEndOf="@id/home_indicator_mine"
            app:layout_constraintStart_toStartOf="@id/home_indicator_mine"
            app:layout_constraintTop_toTopOf="@id/home_indicator_mine" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
