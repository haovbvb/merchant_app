<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="view"
            type="com.okla.ops.views.workbench.QRCodeActivity" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/view_finder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="-100dp"
            android:background="@android:color/transparent"
            app:zxing_framing_rect_height="300dp"
            app:zxing_framing_rect_width="300dp"
            app:zxing_preview_scaling_strategy="fitXY"
            app:zxing_scanner_layout="@layout/layout_custom_barcode_view"
            app:zxing_use_texture_view="true" />

        <include
            android:id="@+id/clHead"
            layout="@layout/include_head_cl_alpha" />

        <LinearLayout
            android:layout_marginTop="16dp"
            android:layout_below="@+id/desc_text_2"
            android:id="@+id/control_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/manual_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="@{view::onClickView}"
                android:gravity="center_horizontal"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/qr_manual_input" />

                <TextView
                    android:id="@+id/manual_input_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/qr_manual_input"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="@{view::onClickView}"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:padding="7dp"
                    android:background="@drawable/bg_80999999_r16"
                    android:id="@+id/flash_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/qr_unlight" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/qr_light"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/desc_text_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="15dp"
            android:alpha="0.6"
            android:gravity="center"
            android:paddingLeft="20dp"
            android:paddingTop="265dp"
            android:paddingRight="20dp"
            android:text="@string/qr_scan_tip"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:visibility="visible" />
    </RelativeLayout>
</layout>