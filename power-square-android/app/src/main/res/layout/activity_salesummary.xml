<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="302dp"
            android:scaleType="fitXY"
            android:scaleY="1.02"
            android:src="@mipmap/icon_sale_statistic_topbg"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:paddingStart="12dp"
            android:src="@mipmap/ic_white_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_sales_performance_statistics"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back_page"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_back_page" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:drawableStart="@mipmap/icon_date2"
                    android:drawableEnd="@mipmap/icon_arrow_down2"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:text="Feb 4 ~ Feb 10"
                    android:textColor="#b3ffffff"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/line1"
                    android:layout_width="1dp"
                    android:layout_height="94dp"
                    android:layout_marginVertical="29dp"
                    android:background="#33ffffff"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_title_total_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@mipmap/icon_tip"
                    android:drawablePadding="3dp"
                    android:text="@string/str_total_sales_amount"
                    android:textColor="#ffffffff"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="@+id/tv_total_amount"
                    app:layout_constraintTop_toTopOf="@+id/line1" />

                <TextView
                    android:id="@+id/tv_total_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:text="-"
                    android:textColor="#ffffffff"
                    android:textSize="25sp"
                    app:layout_constraintEnd_toStartOf="@+id/line1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title_total_amount" />

                <View
                    android:id="@+id/viewbg1"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_ffede2_r13"
                    app:layout_constraintEnd_toEndOf="@+id/tv_rank1"
                    app:layout_constraintStart_toStartOf="@+id/tv_total_amount"
                    app:layout_constraintTop_toBottomOf="@+id/tv_total_amount" />

                <TextView
                    android:id="@+id/tv_title_rank1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@mipmap/icon_rank"
                    android:drawablePadding="3dp"
                    android:text="@string/str_store_ranking"
                    android:textColor="#ffffc93e"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="@+id/viewbg1"
                    app:layout_constraintStart_toStartOf="@+id/viewbg1"
                    app:layout_constraintTop_toTopOf="@+id/viewbg1" />

                <TextView
                    android:id="@+id/tv_rank1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingEnd="6dp"
                    android:text="-"
                    android:textColor="#ffffffff"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/viewbg1"
                    app:layout_constraintStart_toEndOf="@+id/tv_title_rank1"
                    app:layout_constraintTop_toTopOf="@+id/viewbg1" />

                <TextView
                    android:id="@+id/tv_title_order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@mipmap/icon_tip"
                    android:drawablePadding="3dp"
                    android:text="@string/str_transaction_order"
                    android:textColor="#ffffffff"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="@+id/tv_order_account"
                    app:layout_constraintTop_toTopOf="@+id/line1" />

                <TextView
                    android:id="@+id/tv_order_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:text="-"
                    android:textColor="#ffffffff"
                    android:textSize="25sp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_total_amount"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/line1" />

                <View
                    android:id="@+id/viewbg2"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_ffede2_r13"
                    app:layout_constraintEnd_toEndOf="@+id/tv_rank2"
                    app:layout_constraintStart_toStartOf="@+id/tv_order_account"
                    app:layout_constraintTop_toBottomOf="@+id/tv_order_account" />

                <TextView
                    android:id="@+id/tv_title_rank2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@mipmap/icon_rank"
                    android:drawablePadding="3dp"
                    android:text="@string/str_store_ranking"
                    android:textColor="#ffffc93e"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="@+id/viewbg2"
                    app:layout_constraintStart_toStartOf="@+id/viewbg2"
                    app:layout_constraintTop_toTopOf="@+id/viewbg2" />

                <TextView
                    android:id="@+id/tv_rank2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingEnd="6dp"
                    android:text="-"
                    android:textColor="#ffffffff"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/viewbg2"
                    app:layout_constraintStart_toEndOf="@+id/tv_title_rank2"
                    app:layout_constraintTop_toTopOf="@+id/viewbg2" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_f5f6f7_top_r12"
                    app:layout_constraintTop_toBottomOf="@+id/viewbg2">

                    <View
                        android:id="@+id/viewbg_rate"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_fff8f0_ffffff"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_title_rate"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@mipmap/icon_rate"
                        android:drawablePadding="3dp"
                        android:text="@string/str_rate_order_value"
                        android:textColor="#e60c0c0d"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="@+id/viewbg_rate"
                        app:layout_constraintTop_toTopOf="@id/viewbg_rate" />

                    <View
                        android:id="@+id/line2"
                        android:layout_width="0dp"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="41dp"
                        android:background="#ebebeb"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/viewbg_rate"
                        app:layout_constraintTop_toTopOf="@+id/viewbg_rate" />

                    <TextView
                        android:id="@+id/tv_rate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="8dp"
                        android:text="-"
                        android:textColor="#e6000000"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toStartOf="@+id/tv_price"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toStartOf="@+id/line2"
                        app:layout_constraintTop_toBottomOf="@+id/line2" />

                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="-"
                        android:textColor="#e6000000"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="@+id/viewbg_rate"
                        app:layout_constraintStart_toEndOf="@+id/tv_rate"
                        app:layout_constraintTop_toTopOf="@+id/tv_rate" />

                    <TextView
                        android:id="@+id/tv_title_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableEnd="@mipmap/icon_tip2"
                        android:drawablePadding="3dp"
                        android:layoutDirection="ltr"
                        android:paddingBottom="12dp"
                        android:text="@string/str_order_signing_rate"
                        android:textColor="#66000000"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="@+id/tv_rate"
                        app:layout_constraintTop_toTopOf="@+id/tv_title_price" />

                    <TextView
                        android:id="@+id/tv_title_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableEnd="@mipmap/icon_tip2"
                        android:drawablePadding="3dp"
                        android:text="@string/str_average_order_price"
                        android:textColor="#66000000"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="@+id/tv_price"
                        app:layout_constraintTop_toBottomOf="@+id/tv_price" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_ffffff_r10"
                        app:layout_constraintTop_toBottomOf="@+id/viewbg_rate">

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tablayout"
                            app:tabTextAppearance="@style/CustomTabTextAppearance"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:textSize="13sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tabIndicatorColor="@color/main_color"
                            app:tabIndicatorFullWidth="false"
                            app:tabIndicatorHeight="2dp"
                            app:tabMode="fixed"
                            app:tabGravity="start"
                            app:tabPaddingEnd="6dp"
                            app:tabPaddingStart="6dp"
                            app:tabRippleColor="@color/ps_color_transparent"
                            app:tabSelectedTextColor="@color/color_e6000000"
                            app:tabTextColor="@color/color_66000000" />

                        <com.github.mikephil.charting.charts.CombinedChart
                            android:id="@+id/bar_chart"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tablayout" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_ffffff_r8"
                        app:layout_constraintTop_toBottomOf="@+id/layoutbar">

                        <TextView
                            android:id="@+id/tv_title_saledata"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:drawablePadding="3dp"
                            android:gravity="center"
                            android:text="@string/str_sales_data"
                            android:textColor="#e6000000"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/iv_select"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/icon_arrow_down"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_title_saledata"
                            app:layout_constraintStart_toEndOf="@+id/tv_title_saledata"
                            app:layout_constraintTop_toTopOf="@+id/tv_title_saledata" />

                        <View
                            android:id="@+id/line3"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/color_e6e6e6"
                            app:layout_constraintTop_toBottomOf="@+id/tv_title_saledata" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tablayout2"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginVertical="8dp"
                            android:textSize="13sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/line3"
                            app:tabGravity="start"
                            app:tabIndicator="@null"
                            app:tabIndicatorColor="@android:color/transparent"
                            app:tabIndicatorHeight="0dp"
                            app:tabMode="fixed"
                            app:tabPaddingBottom="3dp"
                            app:tabPaddingEnd="6dp"
                            app:tabPaddingStart="6dp"
                            app:tabPaddingTop="3dp"
                            app:tabRippleColor="@android:color/transparent"
                            app:tabSelectedTextColor="@color/main_color"
                            app:tabTextColor="@color/color_99000000" />

                        <com.scwang.smartrefresh.layout.SmartRefreshLayout
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:id="@+id/swipRefresh"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tablayout2"
                            app:srlEnableLoadMore="true"
                            app:srlEnableRefresh="false">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvdata"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                app:layout_constraintBottom_toBottomOf="parent" />
                        </com.scwang.smartrefresh.layout.SmartRefreshLayout>


                        <include
                            layout="@layout/view_data_empty_layout"
                            android:id="@+id/dataEmptyLayout"
                            android:layout_width="0dp"
                            android:layout_height="250dp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tablayout2" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
