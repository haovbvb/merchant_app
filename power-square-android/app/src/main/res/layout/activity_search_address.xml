<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>


        <import type="android.text.TextUtils" />

        <import type="android.view.View" />

        <variable
            name="data"
            type="String" />

        <variable
            name="view"
            type="com.okla.ops.views.workbench.selectaddress.SearchAddressActivity" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fff5f6f7">

        <View
            android:id="@+id/vLine1"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:background="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:scaleType="center"
            android:src="@mipmap/ic_back"
            app:layout_constraintBottom_toBottomOf="@id/vLine1"
            app:layout_constraintEnd_toStartOf="@id/etInput"
            app:layout_constraintStart_toStartOf="@id/vLine1"
            app:layout_constraintTop_toTopOf="@id/vLine1" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_et_f8_r4"
            android:drawableStart="@mipmap/ic_et_search"
            android:drawablePadding="10dp"
            android:ellipsize="end"
            android:hint="@string/search_address_input_tip"
            android:imeOptions="actionSearch"
            android:lines="1"
            android:paddingStart="14dp"
            android:paddingEnd="30dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/text_333"
            android:textColorHint="#999999"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/vLine1"
            app:layout_constraintEnd_toEndOf="@id/vLine1"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintTop_toTopOf="@id/vLine1"
            app:layout_goneMarginEnd="20dp" />

        <ImageView
            android:id="@+id/ivDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:onClick="@{view::onClickView}"
            android:scaleType="center"
            android:src="@mipmap/ic_search_delete"
            android:visibility="@{TextUtils.isEmpty(data) ? View.GONE : View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="@id/etInput"
            app:layout_constraintEnd_toEndOf="@id/etInput"
            app:layout_constraintTop_toTopOf="@id/etInput"
            tools:visibility="visible" />


        <com.scwang.smartrefresh.layout.SmartRefreshLayout
            android:id="@+id/swipRefresh"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vLine1"
            app:srlEnableHeaderTranslationContent="true"
            app:srlEnableLoadMore="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlacesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.scwang.smartrefresh.layout.SmartRefreshLayout>

        <ViewStub
            android:id="@+id/netErrorViewSub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            android:inflatedId="@+id/netErrorViewSub"
            android:layout="@layout/view_net_error_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vLine1" />

        <ViewStub
            android:id="@+id/dataErrorViewSub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            android:inflatedId="@+id/dataErrorViewSub"
            android:layout="@layout/view_data_error_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vLine1" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>