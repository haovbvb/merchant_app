<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_r16_ffffff">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="@string/title_select_agent"
            android:textColor="@color/color_e60c0c0d"
            android:textSize="17sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.okla.ops.weight.SimpleSearchView
            android:id="@+id/vSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="13dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCitySelect"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="13dp"
            android:drawableEnd="@drawable/icon_arrow_down1"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="@string/text_all_city"
            android:textColor="@color/color_99000000"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vSearch" />

        <View
            android:id="@+id/vLine"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/color_e6e6e6"
            app:layout_constraintTop_toBottomOf="@id/tvCitySelect" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAgent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/vLine1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vLine"
            app:layout_constraintVertical_bias="0" />

        <com.base.common.weight.EmptyView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/vLine1"
            app:layout_constraintTop_toBottomOf="@id/vLine" />

        <View
            android:id="@+id/vLine1"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@color/color_f0f2f5"
            app:layout_constraintBottom_toTopOf="@id/btnCancel" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="@string/Cancel"
            android:textColor="@color/color_e6000000"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
