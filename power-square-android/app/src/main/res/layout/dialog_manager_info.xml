<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ffffff_r8">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/cabinet_opt_not_manager_tips"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vLine"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginStart="24dp"
        android:layout_marginTop="19dp"
        android:layout_marginEnd="24dp"
        android:background="@color/color_1a000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <TextView
        android:id="@+id/tvManagerTitle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="@string/device_detail_device_manager"
        android:textColor="@color/color_800c0c0d"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/vLine"
        app:layout_constraintTop_toBottomOf="@id/vLine" />

    <TextView
        android:id="@+id/tvManagerValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:maxLines="2"
        android:textColor="@color/color_e60c0c0d"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tvManagerTitle"
        app:layout_constraintLeft_toRightOf="@id/tvManagerTitle"
        app:layout_constraintRight_toRightOf="@id/vLine"
        app:layout_constraintTop_toTopOf="@id/tvManagerTitle"
        tools:text="Virgie George" />

    <View
        android:id="@+id/vLine1"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@color/color_1a000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvManagerTitle" />

    <TextView
        android:id="@+id/tvPhoneTitle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="@string/cabinet_opt_not_manager_phone"
        android:textColor="@color/color_800c0c0d"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/vLine1"
        app:layout_constraintTop_toBottomOf="@id/vLine1" />

    <TextView
        android:id="@+id/tvPhoneValue"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:textColor="@color/color_0b61d9"
        android:textSize="14sp"
        app:layout_constraintRight_toRightOf="@id/vLine1"
        app:layout_constraintTop_toTopOf="@id/tvPhoneTitle"
        tools:text="18912313109" />

    <View
        android:id="@+id/vLine2"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@color/color_1a000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPhoneTitle" />

    <View
        android:id="@+id/vLine3"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="24dp"
        android:background="@color/color_1a000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vLine2" />

    <TextView
        android:id="@+id/tvOK"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="@string/Confirm"
        android:textColor="@color/color_e60c0c0d"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vLine3" />
</androidx.constraintlayout.widget.ConstraintLayout>