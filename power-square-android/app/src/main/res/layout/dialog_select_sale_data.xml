<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_f3f4f5_r16"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="@string/str_select_data"
            android:textColor="#e60c0c0d"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_sales_data"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ffffff_top_r10_bg"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="@string/str_sales_data"
            android:textColor="#e60c0c0d"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <View
            android:id="@+id/line1"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:background="@color/color_e6e6e6"
            app:layout_constraintEnd_toEndOf="@+id/tv_sales_data"
            app:layout_constraintStart_toStartOf="@+id/tv_sales_data"
            app:layout_constraintTop_toBottomOf="@+id/tv_sales_data" />

        <TextView
            android:id="@+id/tv_after_sale_data"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:background="@drawable/bg_ffffff_bottom_r10_bg"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="@string/str_after_sale_data"
            android:textColor="@color/color_e60c0c0d"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/line1"
            app:layout_constraintStart_toStartOf="@+id/line1"
            app:layout_constraintTop_toBottomOf="@+id/line1" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ffffff_r8"
            android:gravity="center"
            android:text="@string/cc_str_cancel"
            android:id="@+id/btn_cancel"
            android:textColor="#e6000000"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_after_sale_data"
            app:layout_constraintStart_toStartOf="@+id/tv_after_sale_data"
            app:layout_constraintTop_toBottomOf="@+id/tv_after_sale_data" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
