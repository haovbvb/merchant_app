<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:background="@drawable/bg_top_f3f4f5_r16">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="261dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="@string/str_select_battery"
            android:textColor="#e60c0c0d"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_swapbind_select_battery_tip"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_batterys"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_ffffff_r8"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/btn_cancel"
            app:layout_constraintTop_toBottomOf="@+id/tv_tip" />

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_margin="12dp"
            android:text="@string/cc_str_cancel"
            android:textColor="#e6000000"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:background="@drawable/bg_ffffff_r8"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintEnd_toStartOf="@+id/btn_confirm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
      <TextView
          android:visibility="gone"
          app:layout_constraintStart_toEndOf="@+id/btn_cancel"
          android:layout_marginEnd="12dp"
          android:gravity="center"
          android:layout_marginStart="10dp"
          app:layout_constraintTop_toTopOf="@+id/btn_cancel"
          app:layout_constraintEnd_toEndOf="parent"
          android:id="@+id/btn_confirm"
          android:textColor="@color/white"
          android:text="@string/cc_str_confirm"
          android:background="@drawable/bg_btn_confirm"
          android:layout_width="0dp"
          android:layout_height="44dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
