<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp"
    android:background="@color/color_1e2126">

    <EditText
        android:id="@+id/etEnterSn"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginVertical="16dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_1affffff_r8"
        android:drawableStart="@drawable/icon_edit_white"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:hint="@string/transport_manually_enter_sn"
        android:lines="1"
        android:paddingHorizontal="8dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/color_1affffff"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/btn_confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClear"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@mipmap/icon_clear_1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/etEnterSn"
        app:layout_constraintEnd_toEndOf="@id/etEnterSn"
        app:layout_constraintTop_toTopOf="@id/etEnterSn" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginVertical="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_maincolor_r8"
        android:paddingHorizontal="10dp"
        android:text="@string/cc_str_confirm"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/etEnterSn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/etEnterSn"
        app:layout_constraintTop_toTopOf="@+id/etEnterSn" />

    <EditText
        android:id="@+id/etEnterVin"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_1affffff_r8"
        android:drawableStart="@drawable/icon_edit_white"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:hint="@string/transport_manually_enter__vehicle_vin"
        android:lines="1"
        android:paddingStart="8dp"
        android:paddingEnd="49dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/color_1affffff"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/btn_confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etEnterSn"
        tools:text="" />
    <TextView
        android:id="@+id/btn_confirm_vehicle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@color/white"
        android:text="@string/cc_str_confirm"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/etEnterVin"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_maincolor_r8"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClearVin"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@mipmap/icon_clear_1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/etEnterVin"
        app:layout_constraintEnd_toEndOf="@id/etEnterVin"
        app:layout_constraintTop_toTopOf="@id/etEnterVin" />

    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/group_vehicle"
        android:visibility="gone"
        app:constraint_referenced_ids="btn_confirm_vehicle,etEnterVin"/>
</androidx.constraintlayout.widget.ConstraintLayout>