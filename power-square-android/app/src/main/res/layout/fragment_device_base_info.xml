                    <com.okla.ops.custom.deviceinfo.InformationView
                        android:id="@+id/invUserPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:DeviceInfoTitle="@string/device_detail_device_user_phone"
                        app:isShowLine="true" />

                    <com.okla.ops.custom.deviceinfo.InformationView
                        android:id="@+id/invBindTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:DeviceInfoTitle="@string/device_detail_device_bind_time"
                        app:isShowLine="false" />

