                <LinearLayout
                    android:id="@+id/llCarInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_ffffff_r16"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="@{type==2?View.VISIBLE:View.GONE}">

                    <com.okla.ops.custom.deviceinfo.InformationView
                        android:id="@+id/vin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:DeviceInfoTitle="@string/text_vin"
                        app:setInfoValue="@{StringUtil.isDataEmpty(data.vin)}" />

                    <com.okla.ops.custom.deviceinfo.InformationView
                        android:id="@+id/numberplate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:DeviceInfoTitle="@string/device_detail_device_number_plate"
                        app:setInfoValue="@{StringUtil.isDataEmpty(data.carNumber)}" />

                    <com.okla.ops.custom.deviceinfo.InformationView
                        android:id="@+id/invCarInsurance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:DeviceInfoTitle="@string/device_detail_device_insurance_number"
                        app:isShowLine="false"
