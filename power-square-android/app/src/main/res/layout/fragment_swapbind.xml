<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F6F7">

        <!-- 底部确认按钮 (固定部分) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_bottom"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:enabled="false"
                android:background="@drawable/selector_confirm"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/btn_confirm"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- 中间可滚动区域 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/layout_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivRegisterIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="center"
                    android:layout_marginTop="55dp"
                    android:src="@mipmap/icon_swap_bind"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_swapbind"
                    android:textColor="@color/color_e6000000"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/ivRegisterIcon"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />
                <!-- 顶部用户信息 (固定部分) -->

                <com.okla.ops.weight.SnSearchInfoView
                    android:id="@+id/userinfo_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/album_dp_20"
                    android:background="@drawable/bg_top_r16_ffffff"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_car_vehicle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/white"
                    android:padding="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/userinfo_view">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_title_select_car"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_bind_vehicle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <FrameLayout
                        android:id="@+id/fra_car"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        app:layout_constraintEnd_toStartOf="@+id/img_select_car"
                        app:layout_constraintStart_toStartOf="@+id/tv_title_select_car"
                        app:layout_constraintTop_toBottomOf="@id/tv_title_select_car">

                        <TextView
                            android:id="@+id/tvempty_car"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:paddingVertical="16dp"
                            android:text="@string/hint_select_vehicle_to_bind"
                            android:textColor="@color/color_330c0c0d"
                            android:textSize="13sp"
                            tools:text="No Battery Parameters Available" />

                        <include
                            android:id="@+id/layoutcar"
                            layout="@layout/layout_swapbind_select_car"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/img_select_car"
                        android:paddingStart="20dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/icon_arrow_down1"
                        app:layout_constraintBottom_toBottomOf="@+id/fra_car"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/fra_car" />

                    <View
                        android:id="@+id/line1"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/color_e6e6e6"
                        app:layout_constraintTop_toBottomOf="@+id/fra_car" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_title_select_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/str_bind_battery"
                        app:layout_constraintStart_toStartOf="@+id/line1"
                        app:layout_constraintTop_toBottomOf="@+id/line1" />

                    <TextView
                        android:id="@+id/tvempty_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingVertical="16dp"
                        android:text="@string/hint_select_battery_to_bind"
                        android:textColor="@color/color_330c0c0d"
                        android:textSize="13sp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_title_select_battery"
                        tools:text="No Battery Parameters Available" />

                    <ImageView
                        android:id="@+id/img_select_battery"
                        android:paddingStart="20dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/icon_arrow_down1"
                        app:layout_constraintBottom_toBottomOf="@+id/tvempty_battery"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvempty_battery" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBatterys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:visibility="gone"
                        android:orientation="vertical"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/tv_title_select_battery" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:background="@color/white"
                    app:layout_constraintTop_toBottomOf="@+id/layout_car_vehicle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_title_select_pack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/str_package"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvempty_pack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:paddingVertical="16dp"
                        android:text="@string/hint_select_swap_package"
                        android:textColor="@color/color_330c0c0d"
                        android:textSize="13sp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_title_select_pack"
                        tools:text="No Battery Parameters Available" />

                    <ImageView
                        android:id="@+id/img_select_pack"
                        android:paddingStart="20dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="16dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/icon_arrow_down1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_title_select_pack" />

                    <com.okla.ops.views.workbench.sales.BindPackageInfoView
                        android:id="@+id/bindpackageinfoview"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_title_select_pack" />

                    <View
                        android:id="@+id/line2"
                        android:layout_width="0dp"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/color_e6e6e6"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/bindpackageinfoview" />

                    <TextView
                        android:id="@+id/tv_reselect"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="@string/str_reselect"
                        android:textColor="#ff0a5bcc"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="@+id/line2"
                        app:layout_constraintStart_toStartOf="@+id/line2"
                        app:layout_constraintTop_toBottomOf="@+id/line2" />

                    <androidx.constraintlayout.widget.Group
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:id="@+id/groupPackageInfo"
                        app:constraint_referenced_ids="line2,bindpackageinfoview,tv_reselect" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!--                <androidx.recyclerview.widget.RecyclerView-->
                <!--                    android:id="@+id/rvCars"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="150dp"-->
                <!--                    android:layout_marginTop="16dp"-->
                <!--                    android:nestedScrollingEnabled="false"-->
                <!--                    android:overScrollMode="never"-->
                <!--                    android:visibility="gone"-->
                <!--                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"-->
                <!--                    app:layout_constraintTop_toBottomOf="@+id/userinfo_view" />-->


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.core.widget.NestedScrollView>

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="50dp"
            android:scaleType="center"
            android:src="@mipmap/ic_back"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
