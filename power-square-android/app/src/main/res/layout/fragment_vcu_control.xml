<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f5f6f7">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/mSmartRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ffffff_r8"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.okla.ops.custom.deviceinfo.InformationView
                            android:id="@+id/invDeviceSn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:DeviceInfoTitle="@string/str_vehicle_sn" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/str_bluetooth"
                                android:textColor="@color/cc_color_e60c0c0d"
                                android:textSize="17sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.base.common.custom.SlideButton
                                android:id="@+id/iosSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_ffffff_r8"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvVcuCtrl"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:text="@string/str_vcu_control"
                            android:textColor="@color/cc_color_e60c0c0d"
                            android:textSize="16sp"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnStart"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:drawableTop="@drawable/icon_vcu_start"
                            android:drawablePadding="10dp"
                            android:gravity="center_horizontal"
                            android:text="@string/str_onclick_start"
                            android:textColor="@color/color_800c0c0d"
                            android:textSize="13sp"
                            app:layout_constraintEnd_toStartOf="@id/btnLock"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvVcuCtrl" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnLock"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:drawableTop="@drawable/icon_vcu_lock"
                            android:drawablePadding="10dp"
                            android:gravity="center_horizontal"
                            android:text="@string/str_lock"
                            android:textColor="@color/color_800c0c0d"
                            android:textSize="13sp"
                            app:layout_constraintEnd_toStartOf="@id/btnAntiTheft"
                            app:layout_constraintStart_toEndOf="@id/btnStart"
                            app:layout_constraintTop_toTopOf="@id/btnStart" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnAntiTheft"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:drawableTop="@drawable/icon_vcu_anti_theft"
                            android:drawablePadding="10dp"
                            android:gravity="center_horizontal"
                            android:text="@string/str_anti_theft"
                            android:textColor="@color/color_800c0c0d"
                            android:textSize="13sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/btnLock"
                            app:layout_constraintTop_toTopOf="@id/btnStart" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnFindVehicle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp"
                            android:layout_marginBottom="30dp"
                            android:drawableTop="@drawable/icon_vcu_find"
                            android:drawablePadding="10dp"
                            android:gravity="center_horizontal"
                            android:text="@string/str_find_vehicle"
                            android:textColor="@color/color_800c0c0d"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnRemoteLock"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/btnStart" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnRemoteLock"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:drawableTop="@drawable/icon_vcu_remote_lock"
                            android:drawablePadding="10dp"
                            android:gravity="center_horizontal"
                            android:text="@string/str_remote_lock"
                            android:textColor="@color/color_800c0c0d"
                            android:textSize="13sp"
                            app:layout_constraintEnd_toStartOf="@id/btnAntiTheft"
                            app:layout_constraintStart_toEndOf="@id/btnFindVehicle"
                            app:layout_constraintTop_toTopOf="@id/btnFindVehicle" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnRemoteUnlock"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:drawableTop="@drawable/icon_vcu_remote_unlock"
                            android:drawablePadding="10dp"
                            android:gravity="center_horizontal"
                            android:text="@string/str_remote_unlock"
                            android:textColor="@color/color_800c0c0d"
                            android:textSize="13sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/btnRemoteLock"
                            app:layout_constraintTop_toTopOf="@id/btnFindVehicle" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_ffffff_r8"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:text="@string/str_vcu_configuration"
                            android:textColor="@color/cc_color_e60c0c0d"
                            android:textSize="16sp" />

                        <com.okla.ops.custom.deviceinfo.InformationView
                            android:id="@+id/invPlatformUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:DeviceInfoTitle="@string/str_platform_url"
                            app:addRightArrow="true" />

                        <com.okla.ops.custom.deviceinfo.InformationView
                            android:id="@+id/invAPN"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:DeviceInfoTitle="@string/str_apn"
                            app:addRightArrow="true" />

                        <com.okla.ops.custom.deviceinfo.InformationView
                            android:id="@+id/invGpsFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:DeviceInfoTitle="@string/str_gps_query_frequency"
                            app:addRightArrow="true" />

                        <com.okla.ops.custom.deviceinfo.InformationView
                            android:id="@+id/invDataFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:DeviceInfoTitle="@string/str_vehicle_upload_frequency"
                            app:addRightArrow="true" />

                        <com.okla.ops.custom.deviceinfo.InformationView
                            android:id="@+id/invOta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:DeviceInfoTitle="@string/str_ota"
                            app:addRightArrow="true"
                            app:isShowLine="false" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
