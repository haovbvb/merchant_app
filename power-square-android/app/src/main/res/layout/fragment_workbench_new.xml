<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.base.library.utils.StringUtil" />

        <variable
            name="data"
            type="com.okla.ops.beans.WorkbenchStatisticsBean" />

        <variable
            name="view"
            type="com.okla.ops.views.workbench.WorkbenchFragmentNew" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F6F7">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="129dp"
            android:background="@mipmap/icon_workbench_topbg"
            android:scaleType="fitXY"
            android:scaleY="1.05"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_bg"
            android:layout_width="0dp"
            android:layout_height="254dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/mSmartRefresh" />

        <ImageView
            android:id="@+id/ivScan"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="12dp"
            android:scaleType="center"
            android:src="@mipmap/icon_scan"
            android:text="@string/tab_workbench"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_role"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="19sp"
            app:layout_constraintBottom_toBottomOf="@id/ivScan"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivScan"
            tools:text="Warehouse Keeper" />

        <ImageView
            android:id="@+id/iv_down"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_down_triangle"
            app:layout_constraintBottom_toBottomOf="@id/tv_role"
            app:layout_constraintLeft_toRightOf="@id/tv_role"
            app:layout_constraintTop_toTopOf="@id/tv_role" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/mSmartRefresh"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="100dp"
            android:background="@drawable/bg_f5f6f7_top_r12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="50dp"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_saledata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_fff8f0_ffffff"
                        android:visibility="gone"
                        >

                        <TextView
                            android:id="@+id/tv_title_sale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="12dp"
                            android:drawableStart="@mipmap/icon_thismonth_sale"
                            android:text="@string/str_this_month_sale"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="12dp"
                            android:textColor="#4d0c0c0d"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                        <View
                            android:id="@+id/line1"
                            android:layout_marginTop="10dp"
                            app:layout_constraintTop_toBottomOf="@+id/tv_title_sale"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="#FFEBEBEB"/>

                        <TextView
                            android:id="@+id/tv_amount"
                            android:layout_width="0dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintEnd_toStartOf="@+id/tv_quantity"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:text="0"
                            android:textColor="#e6000000"
                            android:textSize="24sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/line1" />

                        <TextView
                            android:id="@+id/tv_amount_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="18dp"
                            android:text="@string/str_transaction_amount"
                            android:textColor="#66000000"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="@+id/tv_amount"
                            app:layout_constraintTop_toBottomOf="@+id/tv_amount" />

                        <TextView
                            android:id="@+id/tv_quantity_title"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp"
                            android:text="@string/str_Order_Quantity"
                            android:textColor="#66000000"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tv_amount_title" />

                        <TextView
                            android:id="@+id/tv_quantity"
                            android:layout_width="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#e6000000"
                            android:textSize="24sp"
                            app:layout_constraintBottom_toTopOf="@+id/tv_quantity_title"
                            app:layout_constraintStart_toStartOf="@+id/tv_quantity_title" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/bg_ffffff_r8"
                        android:nestedScrollingEnabled="false"
                        android:paddingTop="12dp"
                        android:orientation="vertical"
                        app:spanCount="3"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>