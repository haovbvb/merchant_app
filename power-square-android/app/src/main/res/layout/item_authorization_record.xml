<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.text.TextUtils" />

        <variable
            name="data"
            type="com.okla.ops.beans.AuthorizationRecordBean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_ffffff_r10"
            app:layout_constraintBottom_toBottomOf="@id/tvValidityPeriod"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imDevice"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_line_f2f2f2_r4"
            android:padding="1dp"
            app:civ_border_color="@color/white"
            app:civ_border_width="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0" />

        <TextView
            android:id="@+id/tvCabinetSn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lines="1"
            android:textColor="@color/color_e60c0c0d"
            android:textSize="15sp"
            app:layout_constraintLeft_toRightOf="@id/imDevice"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/imDevice"
            tools:text="SN:  STA6011710000009" />

        <TextView
            android:id="@+id/tvAuthorizedTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/color_800c0c0d"
            android:textSize="12sp"
            app:layout_constraintLeft_toRightOf="@id/imDevice"
            app:layout_constraintTop_toBottomOf="@id/tvCabinetSn"
            app:layout_constraintVertical_bias="0"
            tools:text="Authorization time: 09-01 23:22:33" />

        <View
            android:id="@+id/vLine"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="#ebebeb"
            app:layout_constraintTop_toBottomOf="@id/imDevice" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAuthorizationPerson"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:text="@string/cabinet_opt_authorization_person"
            android:textColor="@color/color_e60c0c0d"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vLine" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAuthorizationPersonValue"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical|end"
            android:lines="2"
            android:maxLines="2"
            android:paddingHorizontal="12dp"
            android:textColor="@color/color_800c0c0d"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvAuthorizationPerson"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvAuthorizationPerson"
            app:layout_constraintTop_toTopOf="@id/tvAuthorizationPerson"
            tools:text="Jackson" />

        <View
            android:id="@+id/vLine1"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#ebebeb"
            app:layout_constraintTop_toBottomOf="@id/tvAuthorizationPerson" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValidityPeriod"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:text="@string/cabinet_opt_validity_period"
            android:textColor="@color/color_e60c0c0d"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/vBottomLine"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vLine1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValidityPeriodValue"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical|end"
            android:lines="2"
            android:maxLines="2"
            android:paddingHorizontal="12dp"
            android:textColor="@color/color_800c0c0d"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tvValidityPeriod"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvValidityPeriod"
            app:layout_constraintTop_toTopOf="@id/tvValidityPeriod"
            tools:text="09-01 23:22:00 ~ 09-02 23:21:00" />

        <View
            android:id="@id/vBottomLine"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
