<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
        <variable
            name="index"
            type="Integer" />
        <variable
            name="data"
            type="com.okla.ops.beans.CabinetDetailToolbarBean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="58dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center"
            android:text="@{data.name}"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="essential information" />

        <View
            android:layout_width="20dp"
            android:layout_height="1dp"
            android:visibility="@{index == 3 ? View.VISIBLE : View.GONE}"
            app:layout_constraintStart_toEndOf="@id/tvTitle"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <View
            android:id="@+id/vBottomLine"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:visibility="@{data.select ? View.VISIBLE : View.GONE}"
            android:background="@drawable/bg_fb6800_r2"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="@id/tvTitle"
            android:layout_marginBottom="10dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>