<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="com.okla.ops.beans.CabinetIndicator" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_ffffff_r10"
            app:layout_constraintBottom_toTopOf="@id/vBottom"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivSelect"
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_ff12b34b_r0_r10_r0_r10"
            android:scaleType="center"
            android:src="@mipmap/ic_select"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imDevice"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_line_f2f2f2_r4"
            android:padding="1dp"
            app:civ_border_color="@color/white"
            app:civ_border_width="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0" />

        <TextView
            android:id="@+id/tvCabinetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lines="1"
            android:textColor="@color/color_e60c0c0d"
            android:textSize="15sp"
            app:layout_constraintLeft_toRightOf="@id/imDevice"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/imDevice"
            tools:text="Shenzhen Qianwan Park and Sanram Esquare 12-Slot Station" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_line_ff12b34b_r4"
            android:drawablePadding="2dp"
            android:paddingStart="4dp"
            android:paddingTop="3dp"
            android:paddingEnd="4dp"
            android:paddingBottom="3dp"
            android:text="@{data.showOnlineStatus}"
            android:textColor="@color/color_800c0c0d"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/icon_wifi_s"
            app:layout_constraintLeft_toRightOf="@id/imDevice"
            app:layout_constraintTop_toBottomOf="@id/tvCabinetName"
            app:layout_constraintVertical_bias="0"
            tools:text="在线" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:src="@mipmap/icon_location_item"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAddress" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:drawablePadding="4dp"
            android:paddingEnd="100dp"
            android:text="@{data.stationAddress}"
            android:textColor="@color/color_b30c0c0d"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLocation"
            app:layout_constraintTop_toBottomOf="@id/tvStatus"
            tools:text="Bao'an 71 Quliu Xian'er Road, Bao'an Shenzhen Guangdong" />

        <TextView
            android:id="@+id/tvNavigation"
            android:layout_width="53dp"
            android:layout_height="wrap_content"
            android:drawableTop="@mipmap/monitor_navi"
            android:gravity="center"
            android:textColor="@color/text_333"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tvAddress"
            app:layout_constraintEnd_toEndOf="@id/tvAddress"
            app:layout_constraintTop_toTopOf="@id/tvAddress"
            tools:text="200m" />

        <View
            android:layout_width="1dp"
            android:layout_height="29dp"
            android:layout_marginEnd="8dp"
            android:background="#ececec"
            app:layout_constraintBottom_toBottomOf="@id/tvAddress"
            app:layout_constraintEnd_toStartOf="@id/tvNavigation"
            app:layout_constraintTop_toTopOf="@id/tvAddress" />

        <View
            android:id="@+id/vLine"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:background="#ebebeb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAddress" />

        <HorizontalScrollView
            android:id="@+id/hsv_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:scrollbarThumbHorizontal="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vLine">

            <LinearLayout
                android:id="@+id/ll_detail"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <View
            android:id="@+id/vBottom"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hsv_bottom" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
