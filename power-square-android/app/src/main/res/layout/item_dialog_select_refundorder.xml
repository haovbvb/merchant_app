<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_r8"
        android:layout_marginBottom="12dp"
        android:padding="12dp">

        <ImageView
            android:id="@+id/img_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/icon_grey_unchecked"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_order_no" />

        <TextView
            android:id="@+id/tv_order_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:drawablePadding="5dp"
            android:drawableStart="@mipmap/icon_dialog_select_refundorder"
            android:textColor="#e6000000"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/line1"
            android:layout_marginTop="11dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_order_no"
            android:layout_width="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_order_no"
            android:layout_height="0.5dp"
            android:background="@color/color_e6e6e6"/>
        <TextView
            android:id="@+id/tv_title_time"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toStartOf="@+id/line1"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="@string/str_unbinding_time"
            android:textColor="#99000000"
            android:textSize="13sp"
            />

        <TextView
            android:id="@+id/tv_unbind_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="-"
            android:textColor="#e6000000"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_time" />
        <TextView
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="#fffa7d00"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_unbind_time"
            app:layout_constraintTop_toTopOf="@+id/tv_title_deposit"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_deposit"/>

        <TextView
            android:id="@+id/tv_title_deposit"
            app:layout_constraintStart_toStartOf="@+id/tv_title_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:text="@string/str_depoist"
            android:textColor="#99000000"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_time" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
