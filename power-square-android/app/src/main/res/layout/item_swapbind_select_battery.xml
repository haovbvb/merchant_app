<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp">

        <ImageView
            android:id="@+id/img_battery"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="-"
            android:textColor="#e60c0c0d"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/img_battery"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_sn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:text="-"
            android:textColor="#66000000"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/tv_model"
            app:layout_constraintTop_toBottomOf="@+id/tv_model" />

        <TextView
            android:id="@+id/tv_remain_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="-"
            android:textColor="#99000000"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/tv_sn"
            app:layout_constraintTop_toBottomOf="@+id/tv_sn" />

        <ImageView
            android:id="@+id/img_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/devideline"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="14dp"
            android:background="@color/color_e6e6e6"
            app:layout_constraintTop_toBottomOf="@+id/tv_remain_day" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
