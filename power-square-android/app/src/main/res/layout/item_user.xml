<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_r8"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <com.okla.ops.weight.CircleImageView
            android:id="@+id/ivAvatar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@mipmap/icon_def_avatar"
            app:civ_border_color="@color/white"
            app:civ_border_width="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:singleLine="true"
            android:textColor="@color/color_e6000000"
            android:textSize="16sp"
            android:text="-"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar"
           />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:textColor="@color/color_80000000"
            android:textSize="11sp"
            android:text="-"
            app:layout_constraintStart_toStartOf="@id/tvName"
            app:layout_constraintTop_toBottomOf="@id/tvName"
           />

        <TextView
            android:id="@+id/tvId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_line_26000000_r4"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="ID:-"
            android:textColor="#99000000"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@+id/tvStatus"
            app:layout_constraintTop_toTopOf="@+id/tvStatus" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_f6f8fc_r6"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvStatus">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_order_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/str_order"
                android:gravity="center"
                android:textColor="@color/color_66000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/line1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/color_e6000000"
                android:textSize="15sp"
                android:gravity="center"
                android:text="-"
                app:layout_constraintEnd_toEndOf="@id/tv_order_title"
                app:layout_constraintStart_toStartOf="@id/tv_order_title"
                app:layout_constraintTop_toBottomOf="@id/tv_order_title"
        />

            <View
                android:id="@+id/line1"
                android:layout_width="0.5dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_consumption_value"
                android:layout_marginEnd="20dp"
                android:background="@color/color_12000000"
                app:layout_constraintEnd_toStartOf="@+id/tv_title_consumption"
                app:layout_constraintStart_toEndOf="@+id/tv_order_title"
                app:layout_constraintTop_toTopOf="@+id/tv_order_title" />

            <TextView
                android:id="@+id/tv_title_consumption"
                android:layout_width="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_height="wrap_content"
                android:text="@string/str_total_consumption"
                android:textColor="#80000000"
                android:textSize="12sp"
                android:gravity="center"
                app:layout_constraintEnd_toStartOf="@+id/line2"
                app:layout_constraintTop_toTopOf="@+id/tv_order_title"
                app:layout_constraintStart_toEndOf="@+id/line1" />

            <TextView
                android:id="@+id/tv_consumption_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:layout_marginTop="5dp"
                android:textColor="#e6000000"
                android:textSize="16sp"
                android:gravity="center"
                app:layout_constraintEnd_toStartOf="@+id/line2"
                app:layout_constraintStart_toEndOf="@+id/line1"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_consumption" />
            <View
                android:id="@+id/line2"
                android:layout_width="0.5dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_consumption_value"
                android:layout_marginStart="20dp"
                android:background="@color/color_12000000"
                app:layout_constraintEnd_toStartOf="@+id/tv_assets_value"
                app:layout_constraintStart_toEndOf="@+id/tv_title_consumption"
                app:layout_constraintTop_toTopOf="@+id/tv_title_consumption" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_assets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/str_assets"
                android:textColor="@color/color_66000000"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/line2"
                app:layout_constraintTop_toTopOf="@+id/tv_title_consumption" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_assets_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/color_e6000000"
                android:textSize="15sp"
                android:text="-"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/line2"
                app:layout_constraintTop_toBottomOf="@id/tv_title_assets"
              />

<!--            <View-->
<!--                android:id="@+id/vLine"-->
<!--                android:layout_width="0dp"-->
<!--                android:layout_height="1.5dp"-->
<!--                android:layout_marginTop="12dp"-->
<!--                android:background="@drawable/line_dotted_c9c9c9"-->
<!--                android:visibility="invisible"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                app:layout_constraintTop_toBottomOf="@id/tvUserTypeValue" />-->

<!--            <androidx.appcompat.widget.AppCompatTextView-->
<!--                android:id="@+id/tvPeriod"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="30dp"-->
<!--                android:drawableStart="@drawable/icon_financia"-->
<!--                android:drawablePadding="6dp"-->
<!--                android:gravity="center_vertical"-->
<!--                android:textColor="@color/color_e6000000"-->
<!--                android:textSize="12sp"-->
<!--                android:visibility="gone"-->
<!--                app:layout_constraintBottom_toBottomOf="parent"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                app:layout_constraintTop_toBottomOf="@id/vLine"-->
<!--                tools:text="36 periods" />-->

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_tip"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:paddingStart="12dp"
            android:background="@drawable/bg_f6f8fc_r6"
            android:drawableStart="@mipmap/icon_order_notify"
            android:gravity="center_vertical"
            android:text="-"
            android:textColor="#99000000"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/layout_amount"
            app:layout_constraintStart_toStartOf="@+id/layout_amount"
            app:layout_constraintTop_toBottomOf="@+id/layout_amount" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
