<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_ffffff_r8"
        android:padding="12dp">

        <ImageView
            android:id="@+id/img_battery"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_device_sn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="-"
            android:textColor="#e6000000"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@+id/img_battery"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="-"
            android:textColor="#fffa4332"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@+id/tv_device_sn"
            app:layout_constraintTop_toBottomOf="@+id/tv_device_sn" />

        <TextView
            android:id="@+id/tv_bindtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="-"
            android:background="@drawable/bg_line_26000000_r4"
            android:textColor="#99000000"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@+id/tv_status"
            app:layout_constraintTop_toTopOf="@+id/tv_status" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_f6f8fc_r6"
            app:layout_constraintTop_toBottomOf="@+id/img_battery">

            <TextView
                android:id="@+id/tv_title_soc"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/text_soc"
                android:textColor="#80000000"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_soc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-%"
                android:textColor="#e6000000"
                android:textSize="16sp"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_title_soc"
                app:layout_constraintStart_toStartOf="@+id/tv_title_soc"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_soc" />

            <View
                android:id="@+id/line1"
                android:layout_width="0.5dp"
                android:layout_height="39dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/tv_title_soc"
                app:layout_constraintTop_toTopOf="@+id/tv_title_soc" />

            <TextView
                android:layout_width="0dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/str_specification"
                android:textColor="#80000000"
                android:textSize="12sp"
                android:id="@+id/tv_title_spec"
                app:layout_constraintEnd_toStartOf="@+id/line2"
                app:layout_constraintTop_toTopOf="@+id/tv_title_soc"
                app:layout_constraintStart_toEndOf="@+id/line1" />
            <TextView
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="@+id/tv_title_spec"
                app:layout_constraintStart_toStartOf="@+id/tv_title_spec"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_spec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:id="@+id/tv_spec"
                android:layout_marginTop="5dp"
                android:textColor="#e6000000"
                android:textSize="16sp"
                />
            <View
                android:id="@+id/line2"
                android:layout_width="0.5dp"
                android:layout_height="39dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toStartOf="@+id/tv_title_model"
                app:layout_constraintTop_toTopOf="@+id/tv_title_spec" />
            <TextView
                android:id="@+id/tv_title_model"
                app:layout_constraintTop_toTopOf="@+id/tv_title_soc"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="90dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/device_detail_device_model"
                android:textColor="#80000000"
                android:textSize="12sp"
                />
            <TextView
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="@+id/tv_title_model"
                app:layout_constraintStart_toStartOf="@+id/tv_title_model"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:id="@+id/tv_model"
                android:layout_marginTop="5dp"
                android:textColor="#e6000000"
                android:textSize="16sp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
