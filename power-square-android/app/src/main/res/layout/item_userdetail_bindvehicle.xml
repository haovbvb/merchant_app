<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_ffffff_r8"
        android:padding="12dp">

        <ImageView
            android:id="@+id/img_device"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_device_sn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="-"
            android:textColor="#e6000000"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@+id/img_device"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_line_fa4332_r4"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="@string/str_to_be_maintained"
            android:textColor="#fffa4332"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tv_device_sn"
            app:layout_constraintTop_toBottomOf="@+id/tv_device_sn" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierStatusRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="tv_status" />

        <TextView
            android:id="@+id/tv_bindtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            app:layout_goneMarginStart="0dp"
            android:background="@drawable/bg_line_26000000_r4"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="-"
            android:textColor="#99000000"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@+id/barrierStatusRight"
            app:layout_constraintTop_toTopOf="@+id/tv_status" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_f6f8fc_r6"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toBottomOf="@+id/img_device">

            <TextView
                android:id="@+id/tv_title_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/device_detail_device_model"
                android:textColor="#80000000"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/tv_title_platenum"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_title_platenum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/str_plate_number"
                android:textColor="#80000000"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_title_model"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="@+id/tv_title_model"
                app:layout_constraintStart_toStartOf="@+id/tv_title_model"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_model" />

            <TextView
                android:id="@+id/tv_platenumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="@+id/tv_title_platenum"
                app:layout_constraintStart_toStartOf="@+id/tv_title_platenum"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_platenum" />

            <View
                android:id="@+id/line1"
                android:layout_width="0.5dp"
                android:layout_height="39dp"
                android:layout_marginStart="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_title_model" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_f6f8fc_r6"
            app:layout_constraintTop_toBottomOf="@+id/layout_info">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/device_detail_device_format"
                android:textColor="#80000000"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_spec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
