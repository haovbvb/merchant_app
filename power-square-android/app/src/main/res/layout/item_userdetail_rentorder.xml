<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_ffffff_r8"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_order_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:drawableStart="@mipmap/icon_userdetail_saleorder"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="-"
            android:textColor="#e6000000"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_order_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_order_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="#66000000"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/line1"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"
            android:background="#ebebeb"
            app:layout_constraintEnd_toEndOf="@+id/tv_order_time"
            app:layout_constraintStart_toStartOf="@+id/tv_order_no"
            app:layout_constraintTop_toBottomOf="@+id/tv_order_time" />

        <ImageView
            android:id="@+id/img_device"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="@+id/line1"
            app:layout_constraintTop_toBottomOf="@+id/line1" />

        <TextView
            android:id="@+id/tv_device_sn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="-"
            android:textColor="#e6000000"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@+id/img_device"
            app:layout_constraintTop_toTopOf="@+id/img_device" />

        <TextView
            android:id="@+id/tv_pay_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="-"
            android:background="@drawable/bg_line_26000000_r4"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@+id/tv_device_sn"
            app:layout_constraintTop_toBottomOf="@+id/tv_device_sn" />

        <TextView
            android:id="@+id/tv_pay_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/color_99000000"
            android:background="@drawable/bg_line_26000000_r4"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="-"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@+id/tv_pay_status"
            app:layout_constraintTop_toTopOf="@+id/tv_pay_status" />

        <TextView
            android:id="@+id/tv_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_line_26000000_r4"
            android:text="-"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@+id/tv_pay_type"
            app:layout_constraintTop_toTopOf="@+id/tv_pay_type" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_price"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@mipmap/icon_bind_package_topbg"
            app:layout_constraintTop_toBottomOf="@+id/img_device">

            <TextView
                android:id="@+id/tv_package_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:text="-"
                android:textColor="#e6ffffff"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#ffffffff"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@+id/tv_package_name"
                app:layout_constraintStart_toStartOf="@+id/tv_package_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_package_name" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_f6f8fc_r6"
            app:layout_constraintTop_toBottomOf="@+id/layout_price">

            <TextView
                android:id="@+id/tv_deposit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:text="@string/str_depoist"
                android:textColor="#99000000"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_deposit_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:paddingEnd="12dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_rentday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:text="@string/str_rental_day"
                android:textColor="#99000000"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="@id/tv_deposit"
                app:layout_constraintTop_toBottomOf="@+id/tv_deposit" />

            <TextView
                android:id="@+id/tv_rentday_value"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:paddingEnd="12dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_deposit_value" />

            <TextView
                android:id="@+id/tv_remainday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:text="@string/str_remaining_day"
                android:textColor="#99000000"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="@+id/tv_rentday"
                app:layout_constraintTop_toBottomOf="@+id/tv_rentday" />

            <TextView
                android:id="@+id/tv_remainday_value"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:paddingEnd="12dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_rentday_value" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:text="@string/str_service_expiration_date"
                android:textColor="#99000000"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="@+id/tv_remainday"
                app:layout_constraintTop_toBottomOf="@+id/tv_remainday" />

            <TextView
                android:id="@+id/tv_date_value"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:paddingEnd="12dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_remainday_value" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/viewbg_voucher"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_f6f8fc_r6"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/layout_info" />

        <TextView
            android:id="@+id/tv_voucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@mipmap/icon_view_voucher"
            android:drawablePadding="6dp"
            android:text="@string/str_view_voucher"
            android:textColor="#e6000000"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/viewbg_voucher"
            app:layout_constraintEnd_toEndOf="@+id/viewbg_voucher"
            app:layout_constraintStart_toStartOf="@id/viewbg_voucher"
            app:layout_constraintTop_toTopOf="@+id/viewbg_voucher" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
