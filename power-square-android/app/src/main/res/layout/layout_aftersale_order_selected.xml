<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<ImageView
    android:id="@+id/img_order"
    android:layout_marginTop="25dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:layout_width="28dp"
    android:layout_height="28dp"
    android:src="@mipmap/icon_refundorder"/>
    <TextView
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/img_order"
        android:id="@+id/tv_order_no"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:text="-"
        android:textColor="#e6000000"
        android:textSize="15sp"
        />
    <TextView
        android:id="@+id/tv_orderstatus"
        app:layout_constraintStart_toStartOf="@+id/tv_order_no"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_no"
        android:layout_marginTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="#66000000"
        android:textSize="12sp"
        />
    <View
        android:id="@+id/line1"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_orderstatus"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_order_no"
        android:layout_height="0.5dp"
        android:background="@color/color_e6e6e6"/>
    <TextView
        app:layout_constraintStart_toStartOf="@+id/line1"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_applicable_devices"
        android:id="@+id/tv_title_device"
        android:textColor="#99000000"
        android:textSize="14sp"
        />
    <TextView
        android:id="@+id/tv_device"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="#e6000000"
        android:textSize="14sp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>