<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_f6f8fc_r6"
    android:paddingHorizontal="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="22dp">

    <ImageView
        android:id="@+id/img_device"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_device_sn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="3dp"
        android:text=""
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/img_device"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_value1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_line_26000000_r4"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:text="-"
        android:textColor="#99000000"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@+id/tv_device_sn"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_sn" />

    <TextView
        android:id="@+id/tv_value2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_line_26000000_r4"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:text="-"
        android:textColor="#99000000"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@+id/tv_value1"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_sn" />

    <View
        android:id="@+id/viewbg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="13dp"
        android:background="@drawable/bg_ffffff_r6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_device" />

    <TextView
        android:id="@+id/tv_title_soc"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/text_soc"
        android:textColor="#80000000"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/viewbg"
        app:layout_constraintTop_toTopOf="@+id/viewbg" />

    <TextView
        android:id="@+id/tv_title_soh"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/text_soh"
        android:textColor="#80000000"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewbg" />

    <TextView
        android:id="@+id/tv_title_cycle"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="13dp"
        android:gravity="center"
        android:layout_marginTop="-2dp"
        android:text="@string/text_cycle"
        android:textColor="#80000000"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/viewbg"
        app:layout_constraintTop_toTopOf="@+id/tv_title_soh" />

    <TextView
        android:id="@+id/tv_soc"
        android:layout_width="0dp"
        android:layout_height="19dp"
        android:layout_marginTop="@dimen/dp_4"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="-"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/tv_title_soc"
        app:layout_constraintStart_toStartOf="@+id/tv_title_soc"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_soc" />

    <View
        app:layout_constraintStart_toStartOf="@+id/tv_soc"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_soc"/>
    <TextView
        android:id="@+id/tv_soh"
        android:layout_width="0dp"
        android:layout_height="19dp"
        android:layout_marginTop="@dimen/dp_4"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="-"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/tv_title_soh"
        app:layout_constraintStart_toStartOf="@+id/tv_title_soh"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_soh" />

    <TextView
        android:id="@+id/tv_cycle"
        android:layout_width="0dp"
        android:layout_height="19dp"
        android:layout_marginTop="@dimen/dp_4"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="-"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/tv_title_cycle"
        app:layout_constraintStart_toStartOf="@+id/tv_title_cycle"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_cycle" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_title_soc,tv_title_soh,tv_title_cycle,tv_soc,tv_soh,tv_cycle" />

    <TextView
        android:id="@+id/tv_title_vin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/text_vin"
        android:textColor="#80000000"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/tv_title_plate"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/viewbg"
        app:layout_constraintTop_toTopOf="@id/viewbg" />

    <TextView
        android:id="@+id/tv_title_plate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/str_plate_number"
        android:textColor="#80000000"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/viewbg"
        app:layout_constraintStart_toEndOf="@+id/tv_title_vin"
        app:layout_constraintTop_toTopOf="@id/viewbg" />

    <TextView
        android:id="@+id/tv_vin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
       android:singleLine="true"
        android:text="-"
        android:textColor="#e6000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tv_plate"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@+id/viewbg"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_vin" />

    <TextView
        android:id="@+id/tv_plate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="-"
        android:textColor="#e6000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/viewbg"
        app:layout_constraintStart_toEndOf="@+id/tv_vin"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_plate" />
    <View
        app:layout_constraintStart_toStartOf="@+id/tv_vin"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_vin"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_vehicle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_title_vin,tv_vin,tv_title_plate,tv_plate" />

</androidx.constraintlayout.widget.ConstraintLayout>