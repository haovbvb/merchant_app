<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/viewbg"
            android:layout_width="match_parent"
            android:layout_height="79dp"
            android:background="@mipmap/icon_bind_package_topbg"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            android:text="-"
            android:textColor="#e6ffffff"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="@+id/viewbg"
            app:layout_constraintTop_toTopOf="@+id/viewbg" />

        <TextView
            android:id="@+id/tv_price"
            android:layout_width="0dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_title"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="-"
            android:textColor="#e6ffffff"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_f6f8fc_bottom_r12"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            app:layout_constraintTop_toBottomOf="@+id/viewbg">

            <TextView
                android:id="@+id/tv_title_models"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_applicable_models"
                android:textColor="#66000000"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_device_type_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_title_models"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_sellbind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="tv_device_type_model,tv_title_models" />

            <TextView
                android:id="@+id/tv_service_period_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_servie_period"
                android:textColor="#66000000"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_title_deposit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/str_depoist"
                android:textColor="#66000000"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@+id/tv_service_period"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_service_period"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@+id/tv_service_period_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_service_period_title" />

            <TextView
                android:id="@+id/tv_deposit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="-"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="#e6000000"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@+id/tv_service_period"
                app:layout_constraintTop_toTopOf="@+id/tv_service_period" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_rentbind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="tv_service_period_title,tv_service_period,tv_deposit,tv_title_deposit" />

            <TextView
                android:id="@+id/tv_title_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_available_battery"
                android:textColor="#66000000"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_battery_available"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@+id/tv_title_battery"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_battery" />

            <TextView
                android:id="@+id/tv_title_vehicle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:text="@string/str_available_vehicles"
                android:textColor="#66000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_battery_available"
                app:layout_constraintTop_toTopOf="@+id/tv_title_battery" />

            <TextView
                android:id="@+id/tv_vehicle_available"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_title_vehicle"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_vehicle" />

            <TextView
                android:id="@+id/tv_title_service_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/str_servie_period"
                android:textColor="#66000000"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="@+id/tv_battery_available"
                app:layout_constraintTop_toBottomOf="@+id/tv_battery_available" />

            <TextView
                android:id="@+id/tv_swap_period"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@+id/tv_title_service_period"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_service_period" />

            <TextView
                android:id="@+id/tv_title_swaptime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/str_swap_time"
                android:textColor="#66000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_vehicle_available"
                app:layout_constraintTop_toBottomOf="@+id/tv_vehicle_available" />

            <TextView
                android:id="@+id/tv_swaptime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="-"
                android:textColor="#e6000000"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_title_swaptime"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_swaptime" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_swap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="tv_title_battery,tv_battery_available,tv_swap_period,tv_title_service_period,tv_title_swaptime,tv_swaptime,tv_title_vehicle,tv_vehicle_available" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
