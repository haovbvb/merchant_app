<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

  <View
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_f6f8fc_r6"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="@+id/layout_bookinfo"/>
    <ImageView
        android:id="@+id/iv_vehicle"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_device_sn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:lines="1"
        android:textColor="@color/color_e60c0c0d"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/iv_vehicle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_vehicle"
        tools:text="High speed tow wheeler" />

    <TextView
        android:id="@+id/tv_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:text="-"
        android:background="@drawable/bg_line_26000000_r4"
        android:textColor="#99000000"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@+id/tv_device_sn"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_sn" />

    <TextView
        android:id="@+id/tv_spec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="-"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textColor="#99000000"
        android:textSize="11sp"
        android:background="@drawable/bg_line_26000000_r4"
        app:layout_constraintStart_toEndOf="@+id/tv_model"
        app:layout_constraintTop_toTopOf="@+id/tv_model" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_ffffff_r6"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:id="@+id/layout_userinfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/iv_vehicle"
        app:layout_constraintTop_toBottomOf="@+id/iv_vehicle">

        <TextView
            android:id="@+id/tv_title_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_bind_user"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:textColor="#99000000"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_header"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:textColor="#99000000"
            android:textSize="13sp"
            android:src="@drawable/icon_def_avator"
            app:layout_constraintStart_toStartOf="@+id/tv_title_user"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_user" />

        <TextView
            android:id="@+id/tv_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="-"
            android:textColor="#e6000000"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/iv_header"
            app:layout_constraintTop_toTopOf="@+id/iv_header" />

        <TextView
            android:id="@+id/tv_userid"
            android:layout_width="200dp"
            android:layout_height="13dp"
            android:text="@string/text_ids"
            android:textColor="#99000000"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@+id/tv_username"
            app:layout_constraintTop_toBottomOf="@+id/tv_username" />

        <ImageView
            android:src="@mipmap/icon_phone_maintenance_binduser"
            android:id="@+id/img_phone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_username" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toBottomOf="@+id/layout_userinfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/layout_bookinfo"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_ffffff_r6">
        <com.okla.ops.custom.deviceinfo.InformationView
            android:id="@+id/invBookNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            app:DeviceInfoTitle="@string/maintenance_vehicle_book_no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.okla.ops.custom.deviceinfo.InformationView
            android:id="@+id/invBookDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            app:DeviceInfoTitle="@string/maintenance_vehicle_book_date"
            app:isShowLine="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/invBookNo" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_repair_record"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_ffffff_r8"
            android:drawableEnd="@drawable/icon_list_arrow_right"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:text="@string/text_maintenance_record"
            android:textColor="@color/cc_color_e60c0c0d"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/invBookDate" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_f6f8fc_r6"
        app:layout_constraintTop_toBottomOf="@id/layout_bookinfo">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_rider_past_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="12dp"
            android:drawableStart="@mipmap/icon_ride_behavior"
            android:drawablePadding="6dp"
            android:text="@string/maintenance_rider_title"
            android:textColor="@color/cc_color_e60c0c0d"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tv_rider_past_title"
            app:layout_constraintStart_toStartOf="@id/tv_rider_past_title"
            app:layout_constraintTop_toBottomOf="@id/tv_rider_past_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>