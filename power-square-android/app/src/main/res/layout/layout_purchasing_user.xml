<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/vGap1"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@color/color_f5f6f7"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            app:layout_constraintBottom_toBottomOf="@+id/tvAddress"
            android:id="@+id/vBgUserInfo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_f6f8fc_r6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vGap1" />

        <com.okla.ops.weight.CircleImageView
            android:id="@+id/ivAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="13dp"
            android:layout_marginTop="13dp"
            android:src="@mipmap/icon_def_avatar"
            app:layout_constraintStart_toStartOf="@id/vBgUserInfo"
            app:layout_constraintTop_toTopOf="@id/vBgUserInfo" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="13dp"
            android:ellipsize="end"
            android:lines="1"
            android:singleLine="true"
            android:textColor="@color/color_e6000000"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/vBgUserInfo"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar"
            tools:text="ID: 1234567890" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="13dp"
            android:paddingBottom="13dp"
            android:gravity="center_vertical"
            android:textColor="@color/color_66000000"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/vBgUserInfo"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toBottomOf="@id/tvId"
            tools:text="123 Elm Street, Springfield, IL 62704, USA Beijing Zip: 0951" />

        <com.okla.ops.weight.InputTextView
            android:id="@+id/itAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/vBgUserInfo" />

        <com.okla.ops.weight.InputTextView
            android:id="@+id/itFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/itAccount" />

        <com.okla.ops.weight.InputTextView
            android:id="@+id/itLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/itFirstName" />

        <View
            android:id="@+id/vGap2"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@color/color_f5f6f7"
            app:layout_constraintTop_toBottomOf="@id/itLastName" />

        <com.okla.ops.weight.InputTextView
            android:id="@+id/itPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/vGap2" />

        <com.okla.ops.weight.InputTextView
            android:id="@+id/itBirthday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/itPhone" />

        <com.okla.ops.weight.InputTextView
            android:id="@+id/itEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/itBirthday" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"
            app:layout_constraintTop_toBottomOf="@id/itEmail" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
