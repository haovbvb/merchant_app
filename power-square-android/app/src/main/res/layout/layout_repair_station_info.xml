<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/iv_device"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_station_name"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:text="-"
        android:textColor="#e6000000"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/iv_device"
        app:layout_constraintTop_toTopOf="@+id/iv_device" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@+id/tv_station_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_station_name" />

    <TextView
        android:id="@+id/tv_station_spec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textSize="11sp"
        android:background="@drawable/bg_line_26000000_r4"
        android:textColor="#99000000"
        app:layout_constraintStart_toEndOf="@+id/tv_status"
        app:layout_constraintTop_toBottomOf="@+id/tv_station_name" />
    <ImageView
        android:id="@+id/img_loc"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="@+id/iv_device"
        app:layout_constraintTop_toBottomOf="@+id/iv_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_location_item"/>
    <TextView
        app:layout_constraintTop_toTopOf="@+id/img_loc"
        app:layout_constraintStart_toEndOf="@+id/img_loc"
        android:layout_marginStart="5dp"
        android:layout_width="0dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:id="@+id/tv_address"
        />
    <View
        app:layout_constraintTop_toBottomOf="@+id/tv_address"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@+id/iv_device"
        app:layout_constraintEnd_toEndOf="@+id/tv_address"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/viewbg_time"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        android:background="@drawable/bg_ffffff_r8"/>
    <TextView
        android:id="@+id/tv_time"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_address"
        app:layout_constraintStart_toStartOf="@+id/viewbg_time"
        android:paddingStart="10dp"
        android:paddingVertical="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_creation_time"
        android:textColor="#99000000"
        android:textSize="13sp"
        />
    <TextView
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintTop_toTopOf="@+id/tv_time"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="@+id/viewbg_time"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="-"
        android:gravity="center_vertical"
        android:textColor="#e6000000"
        android:textSize="13sp"
        android:id="@+id/tv_time_value"
        />
    <View
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="10dp"
        app:layout_constraintTop_toBottomOf="@+id/viewbg_time"/>
</androidx.constraintlayout.widget.ConstraintLayout>