<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF5F6F7">

        <include
            android:id="@+id/inclueTitle"
            layout="@layout/base_title_mvvm_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:background="@color/white"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/cl_footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inclueTitle"
            app:layout_constraintVertical_bias="0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_order_type"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/str_rescue_result"
                    android:textColor="@color/color_e60c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/btn_complete"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_f5f8fb_r8"
                    app:layout_constraintEnd_toStartOf="@id/btn_incomplete"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_order_type" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_complete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@mipmap/icon_deal_complete_unselected"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:text="@string/work_task_finish_completed"
                    android:textColor="@color/color_e60c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/btn_complete"
                    app:layout_constraintEnd_toEndOf="@id/btn_complete"
                    app:layout_constraintStart_toStartOf="@id/btn_complete"
                    app:layout_constraintTop_toTopOf="@id/btn_complete" />

                <View
                    android:id="@+id/btn_incomplete"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_f2f4f7_r8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btn_complete"
                    app:layout_constraintTop_toTopOf="@id/btn_complete" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_incomplete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@mipmap/icon_deal_uncomplete_unselected"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:text="@string/str_return_to_factory"
                    android:textColor="@color/color_e60c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/btn_incomplete"
                    app:layout_constraintEnd_toEndOf="@id/btn_incomplete"
                    app:layout_constraintStart_toStartOf="@id/btn_incomplete"
                    app:layout_constraintTop_toTopOf="@id/btn_incomplete" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_description"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:text="@string/work_task_finish_desc"
                    android:textColor="@color/color_e60c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_complete" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@null"
                    android:gravity="top"
                    android:hint="@string/work_task_finish_desc_enter_prompt"
                    android:maxLength="200"
                    android:padding="12dp"
                    android:textColor="@color/color_e60c0c0d"
                    android:textColorHint="@color/color_4d0c0c0d"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_description" />

                <View
                    android:id="@+id/view"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:background="#F5F6F7"
                    app:layout_constraintTop_toBottomOf="@+id/et_description" />

<!--                <TextView-->
<!--                    android:id="@+id/tvPhoto"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginStart="16dp"-->
<!--                    android:layout_marginTop="16dp"-->
<!--                    android:text="@string/str_photo"-->
<!--                    android:textColor="@color/bg_484848"-->
<!--                    android:textSize="14sp"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toBottomOf="@id/et_description" />-->
                <com.okla.ops.views.workbench.sales.installmentPayment.PaymentVoucherView
                    android:id="@+id/voucherview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ffffff_r8"
                    app:layout_constraintTop_toBottomOf="@+id/view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
<!--                <TextView-->
<!--                    android:id="@+id/tvPhotoNum"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginStart="5dp"-->
<!--                    android:layout_marginEnd="16dp"-->
<!--                    android:text="(0/5)"-->
<!--                    android:textColor="@color/color_400c0c0d"-->
<!--                    android:textSize="14sp"-->
<!--                    app:layout_constraintBottom_toBottomOf="@id/tvPhoto"-->
<!--                    app:layout_constraintLeft_toRightOf="@id/tvPhoto"-->
<!--                    app:layout_constraintTop_toTopOf="@id/tvPhoto" />-->

<!--                <androidx.recyclerview.widget.RecyclerView-->
<!--                    android:id="@+id/rvPhotos"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginStart="16dp"-->
<!--                    android:layout_marginTop="12dp"-->
<!--                    android:layout_marginEnd="15dp"-->
<!--                    android:layout_marginBottom="20dp"-->
<!--                    app:layout_constraintBottom_toBottomOf="parent"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toBottomOf="@id/tvPhoto" />-->

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_footer"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nestedScrollView">

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="12dp"
                android:background="@drawable/selector_confirm"
                android:enabled="false"
                android:gravity="center"
                android:text="@string/work_task_finish_submit"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
