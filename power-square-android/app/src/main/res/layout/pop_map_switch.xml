<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="243dp"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_triangle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="16dp"
            android:layout_height="8dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_triangle_up"
            android:contentDescription="@null" />
        <LinearLayout
            android:id="@+id/llTop"
            android:layout_marginTop="-3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_dropdown"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/img_triangle">

            <TextView
                android:id="@+id/tvAll"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingVertical="10dp"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:paddingStart="26dp"
                android:text="@string/text_all"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#26FFFFFF" />

            <TextView
                android:paddingStart="12dp"
                android:id="@+id/tv_no_maintenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:drawableStart="@drawable/shape_circle_ff56b327"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/str_no_maintenance_required"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#26FFFFFF" />

            <TextView
                android:paddingStart="12dp"
                android:id="@+id/tvmaintenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:drawableStart="@drawable/shape_circle_fa4332"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/str_to_be_maintained"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/img_all"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingEnd="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_warehouse_selected"/>

        <ImageView
            android:id="@+id/img_no_maintenance"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingEnd="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_warehouse_selected"/>
        <ImageView
            android:id="@+id/img_maintenance"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingEnd="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_warehouse_selected"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>