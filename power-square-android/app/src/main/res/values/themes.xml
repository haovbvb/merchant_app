<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Ops" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Ops" parent="Base.Theme.Ops" />

    <!-- 头像 -->
    <declare-styleable name="CircleImageView">
        <attr name="civ_border_width" format="dimension" />
        <attr name="civ_border_color" format="color" />
        <attr name="civ_border_overlay" format="boolean" />
        <attr name="civ_fill_color" format="color" />
    </declare-styleable>
    <style name="us_style_text_view">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#b3000000</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>


    <style name="us_style_edit_text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@null</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#E60C0C0D</item>
        <item name="android:textColorHint">#4D0C0C0D</item>
        <item name="android:textCursorDrawable">@drawable/bg_maincolor_cursor</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:lines">1</item>
    </style>
    <style name="us_style_line">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#e6e6e6</item>
    </style>
    <style name="us_style_edit_text_pwd">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">50dp</item>
    <item name="android:background">@null</item>
    <item name="android:drawableEnd">@drawable/us_selector_eyes</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:inputType">textPassword</item>
    <item name="android:maxLength">16</item>
    <item name="android:paddingStart">0dp</item>
    <item name="android:paddingEnd">24dp</item>
    <item name="android:password">true</item>
    <item name="android:textColor">#FF111937</item>
    <item name="android:textColorHint">#FFC5C6CC</item>
    <item name="android:textCursorDrawable">@drawable/bg_maincolor_cursor</item>
    <item name="android:textSize">14sp</item>
    <item name="android:lines">1</item>
    <item name="android:singleLine">true</item>
    </style>
    <style name="us_style_bottom_sheet_dialog" parent="Theme.Design.BottomSheetDialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="septalLineMarginStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:background">@color/color_f0f0f0</item>
    </style>
</resources>