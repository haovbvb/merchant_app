<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="Object" />

        <variable
            name="viewModel"
            type="com.base.library.base.mvvm.BaseViewModel" />
    </data>

    <RelativeLayout
        android:id="@+id/rlContent"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/white"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/topBack"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:scaleType="fitXY"
            android:src="@mipmap/ic_back"
            tools:text="back" />

        <TextView
            android:id="@+id/topLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="14dp"
            android:drawablePadding="3dp"
            android:gravity="center"
            tools:text="title"
            android:textSize="16sp"
            android:textColor="@color/text_333"
            android:visibility="gone" />

        <TextView
            android:id="@+id/topTitle"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/topBack"
            android:layout_toStartOf="@id/topRight"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="16sp"
            android:layout_marginEnd="20dp"
            android:textColor="@color/text_333"
            tools:text="title" />

        <TextView
            android:id="@+id/topSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/topTitle"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:maxLength="12"
            android:paddingBottom="0dp"
            android:visibility="gone" />


        <TextView
            android:id="@+id/topRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="14dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_333"
            android:textSize="12sp"
            tools:text="保存" />

        <ImageView
            android:id="@+id/topRightImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="14dp"
            android:visibility="gone" />

        <!--<View-->
        <!--android:id="@+id/top_bottom_line"-->
        <!--style="@style/LineStyle"-->
        <!--android:layout_alignParentBottom="true"-->
        <!--android:visibility="visible" />-->
    </RelativeLayout>

</layout>