<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cc_bg_ffffff_r16_top"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cc_bg_ffffff_r4"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/take_photo_bt"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#ffffff"
            android:gravity="center"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/dialog_take_photo"
            android:textAllCaps="false"
            android:textColor="@color/text_333"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cc_color_e6e6e6" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/picture_bt"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#ffffff"
            android:gravity="center"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/dialog_select_from_album"
            android:textAllCaps="false"
            android:textColor="@color/text_333"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:background="@color/cc_color_f0f2f5" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cc_bg_ffffff_r4"
        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:text="@string/dialog_cancel"
        android:textColor="@color/cc_color_e60c0c0d"
        android:textSize="14sp" />
</LinearLayout>